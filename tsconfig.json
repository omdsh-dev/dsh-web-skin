{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["ESNext", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"alwaysStrict": false,
		"rootDir": "src",
		"outDir": "lib",
		"strict": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"declaration": false,
		"sourceMap": false
	},
	"include": ["src/**/*.ts"]
}
