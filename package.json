{
  "name": "dsh-web-skin",
  "version": "0.2.0",
  "description": "Six-in-one skin pack for the DeepSeek Harness web GUI — 六合一皮肤包：极简灰/粗野主义/莫兰迪/像素/Solarized/Dracula，设置页一键切换（浅色/深色双档）。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "theme",
    "skin",
    "minimal",
    "brutalism",
    "morandi",
    "pixel",
    "solarized",
    "dracula"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-theme": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6 || ^0.2.0-rc.2",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-store": "^0.1.2-alpha.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-store",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./palettes/*": "./palettes/*.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "palettes",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "tools"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node tools/build.mjs",
    "check": "node tools/check-palette.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build && npm run check"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omdsh-dev/dsh-web-skin.git"
  }
}
